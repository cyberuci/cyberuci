	"dependencies": {
		"@preact/signals": "^2.11.4",
		"@sanity/color-input": "^6.1.9",
		"@schedule-x/calendar": "^4.9.1",
		"@schedule-x/calendar-controls": "^4.9.1",
		"@schedule-x/svelte": "^3.0.0",
		"@schedule-x/theme-default": "^4.9.1",
		"@splinetool/runtime": "^2.0.151",
		"dompurify": "^3.4.17",
		"preact": "^11.2.0",
		"temporal-polyfill": "1.0.8"
	}
}
