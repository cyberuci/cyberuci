{
	"name": "site",
	"version": "0.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && wrangler dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"deploy": "pnpm run build && wrangler deploy",
		"sanity-typegen": "sanity typegen generate",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@portabletext/svelte": "4.0.0",
		"@portabletext/types": "4.0.2",
		"@radix-ui/colors": "3.0.0",
		"@sanity/client": "8.15.0",
		"@sanity/image-url": "2.1.1",
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/enhanced-img": "1.0.0",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/debounce": "1.2.4",
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"@unocss/eslint-config": "66.12.0",
		"@unocss/extractor-svelte": "66.12.0",
		"bits-ui": "2.20.6",
		"clsx": "2.1.1",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import-x": "4.18.0",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"groq": "6.22.0",
		"lucide-svelte": "1.0.1",
		"prettier": "catalog:",
		"sanity": "6.22.0",
		"sass": "1.108.1",
		"simple-icons": "16.37.0",
		"studio": "workspace:^",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tslib": "2.9.1",
		"typescript": "catalog:",
		"typescript-eslint": "8.72.1",
		"unocss": "66.12.0",
		"vite": "8.3.6",
		"wrangler": "4.158.0",
		"zod": "4.6.7"
	},
